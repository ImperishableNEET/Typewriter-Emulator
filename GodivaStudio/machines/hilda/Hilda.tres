ribbon_modes = Array[String](["Black", "Red"])
credits = "The owner photographed Hilda, an Olympia SM9 De Luxe, and her typed pangrams. The printed alphabet comes from the two black specimen lines directly below the introductory text. Carbon contact is estimated from these impressions."
operator_notes = "Type normally or click any printing key. Hold Shift when clicking for its upper face. Typing 1 operates lowercase l.\n\nFor fractions and cents hold Ctrl + Alt + Shift and press Q for ¼, H for ½, T for ¾ or P for ¢.\n\nOlympia layout follows the positions on a US keyboard. The top row from 1 through = operates Hilda’s top row. Left bracket operates ½ / ¼ and the apostrophe key operates ¢ / @. Hold Shift for the second face.\n\nSpace, Backspace and Return position the sheet."
