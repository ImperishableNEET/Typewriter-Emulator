[resource]
script = ExtResource("1")
id = "hilda"
nickname = "Hilda"
model = "Olympia SM9 De Luxe"
rig_script = ExtResource("2")
manifest_path = "res://machines/hilda/manifest.json"
geometry_path = "res://machines/hilda/Hilda.glb"
strike_atlas = ExtResource("4")
pressure_atlas = ExtResource("5")
autosave_path = "user://current.hilda"
document_extension = "hilda"
keyboard = ExtResource("3")
ribbon_modes = Array[String](["Black", "Red"])
credits = "The owner photographed Hilda, an Olympia SM9 De Luxe, and her typed pangrams. The printed alphabet comes from the two black specimen lines directly below the introductory text. Carbon contact is estimated from these impressions."
operator_notes = "Type normally or click any printing key. Hold Shift when clicking for its upper face. Typing 1 operates lowercase l.\n\nFor fractions and cents hold Ctrl + Alt + Shift and press Q for ¼, H for ½, T for ¾ or P for ¢.\n\nOlympia layout follows the positions on a US keyboard. The top row from 1 through = operates Hilda’s top row. Left bracket operates ½ / ¼ and the apostrophe key operates ¢ / @. Hold Shift for the second face.\n\nTab runs to the next stop. Use the set and clear caps beside the spacebar, or Ctrl+= and Ctrl+-, to change the stop at the current column. Ctrl+. clears all stops. The Tab stops menu also offers these controls.\n\nSpace and Backspace move the carriage. Enter operates the return lever. Select single, 1½ or double spacing, or select Free platen for continuous knob rotation. Alt+Up/Down rolls the paper backward/forward by half a line. In View → Carriage close-up, click or drag the lever, selector or either platen knob. Shift-click a knob to reverse. To reset the line register, Ctrl-drag the left knob, or pull it outward before turning. Release to lock, or right-click during the drag to cancel."
